#!/usr/bin/env bash
# music — open Spotify, the official desktop client.
#
# Why this wrapper exists instead of binding the client directly: this chord
# (SUPER+SHIFT+M) used to point at Spotifast, an unofficial AUR client, and
# before that at a `spotify` binary that was never installed — so pressing it
# either failed mute or popped an "install it" notification. The fallback
# below still explains what to do if the client is ever removed again.
#
# Playback needs Spotify Premium; a free account can browse and search.

set -euo pipefail

if command -v spotify >/dev/null 2>&1; then
  if command -v uwsm-app >/dev/null 2>&1; then
    exec uwsm-app -- spotify "$@"
  fi
  exec spotify "$@"
fi

notify-send -u critical "Spotify not installed" \
  "Install it with: omarchy install service spotify" 2>/dev/null || true

echo "spotify not found. Install it with: omarchy install service spotify" >&2
exit 1
