[Desktop Entry]
Name=Earbuds
Comment=Bluetooth headset batteries and connection (quickshell)
# Via qs-ipc, not `quickshell -p ~/...`: Exec lines are not shell-expanded.
Exec=qs-ipc earbuds toggle
Icon=audio-headphones
Terminal=false
Type=Application
Categories=System;Audio;Bluetooth;
Keywords=earbuds;bluetooth;headset;battery;
StartupWMClass=quickshell
