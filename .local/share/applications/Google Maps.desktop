[Desktop Entry]
Version=1.0
Name=Google Maps
# Chromeless Zen window via zenapp, not omarchy-launch-webapp: that helper only
# recognises the Chromium family and falls back to chromium --app=, which is
# how these used to open. zenapp gives each site its own Zen profile.
Exec=zenapp gmaps https://maps.google.com "Google Maps"
Terminal=false
Type=Application
Icon=google-maps
StartupNotify=true
