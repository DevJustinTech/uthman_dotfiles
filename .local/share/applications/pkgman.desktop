[Desktop Entry]
Name=Package Manager
Comment=Search, install, remove and update Arch packages (pacman + AUR via yay)
# Via qs-ipc, not `quickshell -p ~/...`: Exec lines are not shell-expanded, so
# a literal `~` here reaches quickshell unexpanded and the panel never opens.
Exec=qs-ipc pkgman toggle
Icon=system-software-install
Terminal=false
Type=Application
Categories=System;PackageManager;
Keywords=pacman;yay;aur;arch;install;update;
StartupWMClass=quickshell
