#!/bin/bash
# close-all — close every open window, then return to workspace 1.
#
# Dispatchers are sent as Lua (Hyprland 0.56) with a fallback to the legacy
# dispatcher syntax for older builds.

set -u

dispatch() {
  local lua="$1"
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null 2>&1 || true
}

while read -r addr; do
  [[ -n $addr ]] || continue
  dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" closewindow "address:$addr"
done < <(hyprctl clients -j 2>/dev/null | jq -r '.[].address' 2>/dev/null)

dispatch 'hl.dsp.focus({ workspace = "1" })' workspace 1
