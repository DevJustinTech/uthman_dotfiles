#!/bin/bash
# mon-toggle — toggle the internal laptop display on/off (presentation mode).
#
# Delegates to Omarchy's toggle: it refuses to disable the only active
# display (the old local version could blank a single-monitor session with no
# way back), persists the state for the next login, and the clamshell watcher
# can recover the panel. SUPER+CTRL+DELETE is the same toggle as a bind.
exec omarchy-hyprland-monitor-internal "${1:-toggle}"
