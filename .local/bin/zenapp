#!/usr/bin/env bash
# zenapp — open a URL in a chromeless per-site Zen window (Chrome --app style).
# usage: zenapp <name> <url> [title-regex]
#
# The Zen counterpart of ffapp. Zen, unlike Chromium, has no --app= flag, so
# "chromeless" is done with userChrome.css — the same mechanism getTheme uses
# for the main profile. Each app gets its own profile under
# ~/.config/zen/apps.<name>, so apps keep separate cookies and run beside the
# main browser and each other (--no-remote + a per-app profile: a second
# process on one profile would hit the profile lock, so sharing the main
# profile is not an option).
set -euo pipefail

APP=${1:?usage: zenapp <name> <url> [title-regex]}
URL=${2:?usage: zenapp <name> <url> [title-regex]}
MATCH=${3:-}

PROFDIR="$HOME/.config/zen/apps.$APP"
THEME="$HOME/.config/theme/current"

# Dotfiles root, from this script's real path. The ~/.local/bin entry is a stow
# symlink, so BASH_SOURCE alone would resolve to ~/.local/bin and miss firefox/.
SELF=$(readlink -f "${BASH_SOURCE[0]}")
DOTFILES_DIR=$(cd "$(dirname "$SELF")/../.." && pwd)

# Address of this app's window, or empty. Windows are matched by pid as well as
# title: title alone would happily pick up the main browser when, say, WhatsApp
# Web is open there. A title that no longer matches still falls back to the
# app's first window, so navigating away focuses instead of duplicating.
app_window() {
    command -v hyprctl >/dev/null 2>&1 || return 1
    command -v jq >/dev/null 2>&1 || return 1
    local pids
    pids=$(pgrep -f -- "-profile $PROFDIR" 2>/dev/null | paste -sd, - || true)
    [ -n "$pids" ] || return 1
    hyprctl clients -j 2>/dev/null | jq -r --arg m "$MATCH" --arg p "$pids" '
        ($p | split(",") | map(tonumber)) as $pids
        | [ .[] | select(.pid as $x | $pids | index($x)) ] as $w
        | (( $w | map(select((.title // "") | test($m; "i"))) ) + $w)
        | .[0].address // empty'
}

# The window argument is the STRING "address:0x…". A bare hex number -- which is
# what config/quickshell/AGENTS.md documents -- makes hl.focus report
# "window not found" for a perfectly valid window, and the same mistake is in
# ThemeEditor.qml and WorkspaceViewer.qml.
#
# hyprctl also exits 0 even when the dispatcher refuses the call, so the focus is
# confirmed rather than assumed: a silent refusal would otherwise look like
# success and the caller would open a duplicate.
focus_window() {
    local addr=$1 i
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1
    for i in 1 2 3 4 5; do
        [ "$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')" = "$addr" ] && return 0
        sleep 0.1
    done
    return 1
}

# Already running on this profile? Focus its window. A second launch must never
# open a duplicate -- that is the whole point of these entries.
if pgrep -f -q -- "-profile $PROFDIR" 2>/dev/null; then
    addr=$(app_window || true)
    if [ -n "$addr" ] && focus_window "$addr"; then
        exit 0
    fi
    # Running, but nothing could be focused (still starting up, or every window
    # closed): hand the URL to the live instance instead of starting a second
    # process on a profile that is already locked.
    exec uwsm-app -- zen --profile "$PROFDIR" --new-window "$URL"
fi

# Zen refuses to start on a -profile path that does not exist yet — it opens a
# "Profile Missing" window instead — so the profile has to be there first.
mkdir -p "$PROFDIR/chrome"

# Chromeless + themed, recomposed on every launch so a wallpaper change lands
# without re-provisioning. Real files, not symlinks: Zen's sandboxed UI process
# silently skips a symlinked userChrome.css.
{
    if [ -f "$DOTFILES_DIR/firefox/app-userChrome.css" ]; then
        cat "$DOTFILES_DIR/firefox/app-userChrome.css"
    else
        # Without this the window is an ordinary browser window with tabs.
        printf '%s\n' '#navigator-toolbox { display: none !important; }'
    fi
    for _css in "$THEME/firefox.css" "$THEME/zen.css"; do
        [ -f "$_css" ] || continue
        printf '\n'
        cat "$_css"
    done
} > "$PROFDIR/chrome/userChrome.css"
if [ -f "$THEME/zen-usercontent.css" ]; then
    cp -f "$THEME/zen-usercontent.css" "$PROFDIR/chrome/userContent.css"
fi

# user.js is read at startup and never written by Zen, so it stays declarative.
# First run only: anything added here later would not reach existing profiles,
# but clobbering it every launch would drop hand-edits.
if [ ! -f "$PROFDIR/user.js" ]; then
    cat > "$PROFDIR/user.js" <<'PREFS'
// Managed by zenapp from the dotfiles. Written once, on profile creation.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("zen.welcome-screen.seen", true);
PREFS
fi

exec uwsm-app -- zen --no-remote -profile "$PROFDIR" --new-window "$URL"
