#!/bin/bash
# touchpad [on|off|toggle] — enable/disable the laptop touchpad.
#
# Delegates to Omarchy's toggle: it flips the device through the Hyprland Lua
# device API, shows the OSD, and writes the state file its login-time restore
# reads. A local version meant the touchpad came back on every login.
exec omarchy-toggle-touchpad "${1:-toggle}"
