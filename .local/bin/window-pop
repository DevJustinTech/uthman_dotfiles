#!/bin/bash
# window-pop [width height x y] — pop the focused tile out into a pinned float.
#
# Running it again on a popped window puts it back into the tiling layout.
# Defaults are sized for a 1366x768 panel; pass explicit values on a larger
# monitor.

set -u

width=${1:-1000}
height=${2:-700}
x=${3:-}
y=${4:-}

active=$(hyprctl activewindow -j 2>/dev/null)
pinned=$(echo "$active" | jq -r '.pinned // false' 2>/dev/null)
addr=$(echo "$active" | jq -r '.address // empty' 2>/dev/null)

dispatch() {
  local lua="$1"
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null 2>&1 || true
}

[[ -n $addr && $addr != "null" ]] || exit 0
window="address:$addr"

if [[ $pinned == "true" ]]; then
  dispatch "hl.dsp.window.pin({ window = \"$window\" })" pin "$window"
  dispatch "hl.dsp.window.float({ window = \"$window\", action = \"toggle\" })" togglefloating "$window"
  dispatch "hl.dsp.window.tag({ window = \"$window\", tag = \"-pop\" })" tagwindow -pop "$window"
else
  dispatch "hl.dsp.window.float({ window = \"$window\", action = \"toggle\" })" togglefloating "$window"
  dispatch "hl.dsp.window.resize({ window = \"$window\", x = $width, y = $height })" resizeactive exact "$width" "$height"
  if [[ -n $x && -n $y ]]; then
    dispatch "hl.dsp.window.move({ window = \"$window\", x = $x, y = $y })" moveactive "$x" "$y"
  else
    dispatch "hl.dsp.window.center({ window = \"$window\" })" centerwindow
  fi
  dispatch "hl.dsp.window.pin({ window = \"$window\" })" pin "$window"
  dispatch "hl.dsp.window.alter_zorder({ window = \"$window\", mode = \"top\" })" alterzorder top "$window"
  dispatch "hl.dsp.window.tag({ window = \"$window\", tag = \"+pop\" })" tagwindow +pop "$window"
fi
