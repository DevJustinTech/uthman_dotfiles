[Unit]
Description=PhoneBridge wireless link watchdog (phone-reconnect watch)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# %h expands to the invoking user's home. This used to hardcode
# /home/uthman on all three lines, which pointed at a path that does not
# exist on any other machine -- the service would start and immediately fail
# on ExecStart, and the stale HOME would break anything it shelled out to.
ExecStart=%h/.local/bin/phone-reconnect watch
Restart=on-failure
RestartSec=15
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
