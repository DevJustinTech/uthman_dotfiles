[Desktop Entry]
Name=Bluetooth
Comment=Adapter power, scan, pair and connect Bluetooth devices (quickshell)
# Via qs-ipc, not `quickshell -p ~/...`: Exec lines are not shell-expanded.
Exec=qs-ipc bluetooth toggle
Icon=bluetooth
Terminal=false
Type=Application
Categories=System;Bluetooth;Settings;
Keywords=bluetooth;pair;connect;headset;wireless;
StartupWMClass=quickshell
