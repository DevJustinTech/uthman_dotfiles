#!/usr/bin/env bash
# music — open Spotifast, the native Spotify client.
#
# Why this wrapper exists instead of binding `spotifast` directly: the old
# SUPER+SHIFT+M ran `uwsm-app -- spotify` against a client that was never
# installed here, so pressing it produced a bare "command not found: spotify"
# with nothing on screen explaining what to do. Spotifast ships in the AUR
# only, so this tells you how to get it rather than failing mute.
#
# Playback needs Spotify Premium; a free account can browse and search.

set -euo pipefail

if command -v spotifast >/dev/null 2>&1; then
  exec spotifast "$@"
fi

notify-send -u critical "Spotifast not installed" \
  "Install it with:  yay -S spotifast-bin" 2>/dev/null || true

echo "spotifast not found. Install it with: yay -S spotifast-bin" >&2
exit 1
