[Unit]
Description=EdgeMotion-style touchpad drag continuation (Synaptics-style edge drag)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/dotfiles/.local/bin/edge-motion --verbose --zone-frac-x 0.20 --zone-frac-y 0.12 --dwell 250
Restart=on-failure
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# One-time root setup for device access (touchpad + /dev/uinput):
#     sudo ~/.local/bin/edge-motion-install
#
# Tuning — the values above were chosen by replaying a recording of real
# touch gestures (raw evdev stream) through the state machine: wider zones
# + 250ms dwell glide on genuine edge pushes and stay silent on ordinary
# drags (shorter dwell + wide zones false-triggered at drag starts).
#
#     --zone-frac-x 0.20   horizontal edge zone (wide: pushed blind while
#                          watching the screen; ordinary drags start clear
#                          of it and leave it within the dwell)
#     --zone-frac-y 0.12   vertical edge zone (narrower: normal dragging
#                          lives near the pad's top/bottom)
#     --dwell 250          ms pinned in the zone before gliding starts
#     --lock-gap 1000      drag lock: a re-touch this soon after lifting
#                          mid-drag continues the drag (lift to reposition
#                          before pushing a pad edge, glides included) --
#                          slurp-tap's --lock-gap shares the value, so the
#                          pick and the glide continue together
#     --tap-gap 500        double-tap window: the gap between the two taps
#     --tap-move 400       max summed axis travel to count as a tap --
#                          both identical to slurp-tap's --double-gap and
#                          --tap-move, so both tools accept the same taps
#     --gesture-window 2500 how long after the double-tap a touch still
#                          counts as its drag half -- must stay in step
#                          with slurp-tap's --gesture-window, or the pick
#                          opens while gliding has already disarmed
#     --min-speed 380      px/s at glide start
#     --max-speed 1500     px/s after ramp-up
#     --ramp 1400          ms to reach the max speed
#     --flip-x / --flip-y  invert glide on an axis (if it feels backwards)
#
# Debug: journalctl --user -u edge-motion -f
# Live state: kill -USR1 $(systemctl --user show -p MainPID --value edge-motion)

[Install]
WantedBy=graphical-session.target
